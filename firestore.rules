rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validRole(role) {
      return role in ['viktor', 'jericka'];
    }

    function room(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data;
    }

    function ownsRole(roomId, role) {
      return signedIn()
        && validRole(role)
        && (
          (role == 'viktor' && room(roomId).participants.viktor.uid == request.auth.uid) ||
          (role == 'jericka' && room(roomId).participants.jericka.uid == request.auth.uid)
        );
    }

    function isParticipant(roomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId))
        && (
          room(roomId).participants.viktor.uid == request.auth.uid ||
          room(roomId).participants.jericka.uid == request.auth.uid
        );
    }

    // Which role (if any) the caller is signed in as within this room —
    // used so a person can react to their PARTNER's photos, not just their
    // own, without needing full photo-owner write access.
    function callerRole(roomId) {
      return room(roomId).participants.viktor.uid == request.auth.uid
        ? 'viktor'
        : (room(roomId).participants.jericka.uid == request.auth.uid ? 'jericka' : null);
    }

    // `location` is optional — rooms created before this field existed
    // simply don't carry it — but must be well-formed when present.
    function validLocation(data) {
      return !('location' in data) || data.location == null || (
        data.location is map
        && data.location.keys().hasOnly(['name', 'country', 'latitude', 'longitude', 'timezone'])
        && data.location.name is string
        && data.location.name.size() <= 60
        && data.location.country is string
        && data.location.country.size() <= 60
        && data.location.latitude is number
        && data.location.latitude >= -90
        && data.location.latitude <= 90
        && data.location.longitude is number
        && data.location.longitude >= -180
        && data.location.longitude <= 180
        && data.location.timezone is string
        && data.location.timezone.size() <= 60
      );
    }

    function participantKeysAreValid(data) {
      return data.keys().hasOnly([
        'uid',
        'joined',
        'photoCount',
        'completed',
        'lastActiveAt',
        'location',
        'shootingAt'
      ])
        && validLocation(data)
        // Optional — stamped when someone starts a countdown so the other
        // side can show they're mid-shoot, and simply allowed to go stale.
        && (!('shootingAt' in data) || data.shootingAt == null || data.shootingAt is timestamp);
    }

    function roomKeysAreValid(data) {
      return data.keys().hasOnly([
        'createdAt',
        'updatedAt',
        'status',
        'createdBy',
        'title',
        'customMessage',
        'anniversaryDate',
        'syncCountdown',
        'collage',
        'poke',
        'posePrompt',
        'participants'
      ]);
    }

    function validRoomShape(data) {
      return roomKeysAreValid(data)
        && data.status in ['waiting', 'shooting', 'ready', 'completed']
        && data.participants.keys().hasOnly(['viktor', 'jericka'])
        && participantKeysAreValid(data.participants.viktor)
        && participantKeysAreValid(data.participants.jericka)
        && data.participants.viktor.photoCount is int
        && data.participants.jericka.photoCount is int
        && data.participants.viktor.photoCount >= 0
        && data.participants.viktor.photoCount <= 3
        && data.participants.jericka.photoCount >= 0
        && data.participants.jericka.photoCount <= 3
        && data.customMessage is string
        && data.customMessage.size() <= 80
        // Optional — older rooms were created before this field existed.
        && (!('anniversaryDate' in data) || data.anniversaryDate == null || (
          data.anniversaryDate is string && data.anniversaryDate.size() <= 10
        ))
        // Optional — either participant may set this (to request a synced
        // "shoot together" countdown) or clear it back to null once it's
        // fired; validRoomShape doesn't care WHO changed it, canUpdateRoom
        // below already restricts writes to the two known participants.
        && (!('syncCountdown' in data) || data.syncCountdown == null || (
          data.syncCountdown is map
          && data.syncCountdown.keys().hasOnly(['requestedBy', 'requestedAt', 'seconds'])
          && data.syncCountdown.requestedBy in ['viktor', 'jericka']
          && data.syncCountdown.requestedAt is timestamp
          && (!('seconds' in data.syncCountdown) || (
            data.syncCountdown.seconds is int
            && data.syncCountdown.seconds >= 1
            && data.syncCountdown.seconds <= 30
          ))
        ))
        // Optional — a contentless nudge. Overwritten on each send and never
        // cleared; the receiving client dedupes on the timestamp and ignores
        // anything stale, so there is no state here worth protecting beyond
        // the shape.
        && (!('poke' in data) || data.poke == null || (
          data.poke is map
          && data.poke.keys().hasOnly(['from', 'at'])
          && data.poke.from in ['viktor', 'jericka']
          && data.poke.at is timestamp
        ))
        // Optional — the shared pose card. Only the id travels; the wording
        // lives in the client, which is why this is capped at a short string
        // rather than being validated against a list the rules would have to
        // be redeployed to change.
        && (!('posePrompt' in data) || data.posePrompt == null || (
          data.posePrompt is map
          && data.posePrompt.keys().hasOnly(['id', 'dealtBy', 'dealtAt'])
          && data.posePrompt.id is string
          && data.posePrompt.id.size() > 0
          && data.posePrompt.id.size() <= 40
          && data.posePrompt.dealtBy in ['viktor', 'jericka']
          && data.posePrompt.dealtAt is timestamp
        ))
        // Optional — only set once someone publishes a collage to the room.
        && (!('collage' in data) || data.collage == null || (
          data.collage is map
          && data.collage.keys().hasOnly(['storagePath', 'downloadUrl', 'savedBy', 'savedAt', 'layout', 'theme', 'format'])
          && data.collage.storagePath is string
          && data.collage.downloadUrl is string
          && data.collage.savedBy in ['viktor', 'jericka']
        ));
    }

    function creatingOwnRoom(data) {
      return signedIn()
        && validRoomShape(data)
        && data.createdBy == request.auth.uid
        && (
          (
            data.participants.viktor.uid == request.auth.uid &&
            data.participants.jericka.uid == null &&
            data.participants.viktor.photoCount == 0 &&
            data.participants.jericka.photoCount == 0
          ) ||
          (
            data.participants.jericka.uid == request.auth.uid &&
            data.participants.viktor.uid == null &&
            data.participants.jericka.photoCount == 0 &&
            data.participants.viktor.photoCount == 0
          )
        );
    }

    function canUpdateRoom() {
      return signedIn()
        && validRoomShape(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && (
          resource.data.participants.viktor.uid == request.auth.uid ||
          resource.data.participants.jericka.uid == request.auth.uid ||
          (
            resource.data.participants.viktor.uid == null &&
            request.resource.data.participants.viktor.uid == request.auth.uid &&
            request.resource.data.participants.jericka.uid == resource.data.participants.jericka.uid
          ) ||
          (
            resource.data.participants.jericka.uid == null &&
            request.resource.data.participants.jericka.uid == request.auth.uid &&
            request.resource.data.participants.viktor.uid == resource.data.participants.viktor.uid
          )
        );
    }

    match /rooms/{roomId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if creatingOwnRoom(request.resource.data);
      allow update: if canUpdateRoom();
      allow delete: if isParticipant(roomId);

      match /photos/{photoId} {
        function validPhoto(data) {
          return data.keys().hasOnly([
            'owner',
            'ownerUid',
            'index',
            'storagePath',
            'downloadUrl',
            'createdAt',
            'width',
            'height',
            'caption',
            'reactions',
            'doodles'
          ])
          && validRole(data.owner)
          && data.ownerUid == request.auth.uid
          && data.index is int
          && data.index >= 1
          && data.index <= 3
          && data.storagePath is string
          && data.storagePath.matches('photobooth/' + roomId + '/' + data.owner + '/photo-[1-3]\\.jpg')
          && data.downloadUrl is string
          && data.caption is string
          && data.caption.size() <= 36
          // `reactions` is optional in the schema (older photos were
          // created before this field existed) but must be well-formed
          // when it IS present.
          && (!('reactions' in data) || (
            data.reactions is map
            && data.reactions.keys().hasOnly(['viktor', 'jericka'])
            && (!('viktor' in data.reactions) || data.reactions.viktor is bool)
            && (!('jericka' in data.reactions) || data.reactions.jericka is bool)
          ))
          // Same shape as reactions, and optional for the same reason. Each
          // person owns one key; the cap matches DOODLE_MAX_CHARS in the
          // client, so an accidental scribble can't grow without bound while
          // somebody rests a finger on the screen.
          && (!('doodles' in data) || (
            data.doodles is map
            && data.doodles.keys().hasOnly(['viktor', 'jericka'])
            && (!('viktor' in data.doodles) || (
              data.doodles.viktor is string && data.doodles.viktor.size() <= 4000
            ))
            && (!('jericka' in data.doodles) || (
              data.doodles.jericka is string && data.doodles.jericka.size() <= 4000
            ))
          ));
        }

        // A participant may react to ANY photo in the room (their own or
        // their partner's) without being its owner — as long as the only
        // thing changing is the `reactions` map, and only their own key
        // within it.
        function isReactionOnlyUpdate(role) {
          let before = resource.data;
          let after = request.resource.data;
          let beforeReactions = ('reactions' in before) ? before.reactions : {};
          let afterReactions = after.reactions;
          return validRole(role)
            && before.diff(after).affectedKeys().hasOnly(['reactions'])
            && afterReactions is map
            && afterReactions.keys().hasOnly(['viktor', 'jericka'])
            && (!('viktor' in afterReactions) || afterReactions.viktor is bool)
            && (!('jericka' in afterReactions) || afterReactions.jericka is bool)
            && (role == 'viktor'
                ? afterReactions.get('jericka', false) == beforeReactions.get('jericka', false)
                : afterReactions.get('viktor', false) == beforeReactions.get('viktor', false));
        }

        // The same arrangement as reactions, one field over: either person
        // may draw on any photo in the room, but only inside their own key —
        // so neither can rub out the other's marker.
        function isDoodleOnlyUpdate(role) {
          let before = resource.data;
          let after = request.resource.data;
          let beforeDoodles = ('doodles' in before) ? before.doodles : {};
          let afterDoodles = after.doodles;
          return validRole(role)
            && before.diff(after).affectedKeys().hasOnly(['doodles'])
            && afterDoodles is map
            && afterDoodles.keys().hasOnly(['viktor', 'jericka'])
            && (!('viktor' in afterDoodles) || (
              afterDoodles.viktor is string && afterDoodles.viktor.size() <= 4000
            ))
            && (!('jericka' in afterDoodles) || (
              afterDoodles.jericka is string && afterDoodles.jericka.size() <= 4000
            ))
            && (role == 'viktor'
                ? afterDoodles.get('jericka', '') == beforeDoodles.get('jericka', '')
                : afterDoodles.get('viktor', '') == beforeDoodles.get('viktor', ''));
        }

        allow get, list: if isParticipant(roomId);
        allow create, update: if isParticipant(roomId)
          && (
            (validPhoto(request.resource.data) && ownsRole(roomId, request.resource.data.owner))
            || isReactionOnlyUpdate(callerRole(roomId))
            || isDoodleOnlyUpdate(callerRole(roomId))
          );
        allow delete: if isParticipant(roomId);
      }
    }
  }
}
