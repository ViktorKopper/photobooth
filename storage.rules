rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function roomDoc(roomId) {
      return firestore.get(/databases/(default)/documents/rooms/$(roomId)).data;
    }

    function ownsRole(roomId, role) {
      return signedIn()
        && role in ['viktor', 'jericka']
        && (
          (role == 'viktor' && roomDoc(roomId).participants.viktor.uid == request.auth.uid) ||
          (role == 'jericka' && roomDoc(roomId).participants.jericka.uid == request.auth.uid)
        );
    }

    function isParticipant(roomId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/rooms/$(roomId))
        && (
          roomDoc(roomId).participants.viktor.uid == request.auth.uid ||
          roomDoc(roomId).participants.jericka.uid == request.auth.uid
        );
    }

    match /photobooth/{roomId}/{role}/{fileName} {
      allow read: if isParticipant(roomId);
      allow create, update: if ownsRole(roomId, role)
        && fileName.matches('photo-[1-3]\\.jpg')
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg');
      allow delete: if isParticipant(roomId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
