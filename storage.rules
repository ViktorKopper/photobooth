rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function roomDoc(roomId) {
      return firestore.get(/databases/(default)/documents/rooms/$(roomId)).data;
    }

    function ownsRole(roomId, role) {
      return signedIn()
        && role in ['viktor', 'jericka']
        && (
          (role == 'viktor' && roomDoc(roomId).participants.viktor.uid == request.auth.uid) ||
          (role == 'jericka' && roomDoc(roomId).participants.jericka.uid == request.auth.uid)
        );
    }

    function isParticipant(roomId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/rooms/$(roomId))
        && (
          roomDoc(roomId).participants.viktor.uid == request.auth.uid ||
          roomDoc(roomId).participants.jericka.uid == request.auth.uid
        );
    }

    // Saved collages, one per booth, kept outside the photobooth/ prefix so
    // they survive both the two-day Storage lifecycle sweep and the booth
    // being deleted.
    //
    // Access is granted to any signed-in user rather than to participants
    // of the room, because by design these outlive the room document that
    // participation is derived from — once the booth is gone there is
    // nothing left to check against. The file name is the room's own
    // twelve-character random id, so this matches the protection the rooms
    // themselves already rely on: unguessable, not enumerable.
    match /keepsakes/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && fileName.matches('[A-Z0-9]{6,32}\\.png')
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/png');
      allow delete: if signedIn();
    }

    match /photobooth/{roomId}/{role}/{fileName} {
      allow read: if isParticipant(roomId);
      allow create, update: if ownsRole(roomId, role)
        && fileName.matches('photo-[1-3]\\.jpg')
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg');
      allow delete: if isParticipant(roomId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
